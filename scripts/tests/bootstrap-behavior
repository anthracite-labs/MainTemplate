#!/usr/bin/env sh
# Deterministic, offline behavior tests for scripts/bootstrap-repository.
#
# Each scenario runs the real bootstrap against a fixture Git repository with
# a mocked `gh` on PATH (the controlled mockable boundary): no network, no
# mutation of any real repository or of GitHub state. GitHub responses and
# writes are fixture files plus a mutation log, so ordering, idempotence, and
# refusal behavior are asserted exactly. POSIX sh + git + jq only.
set -u

T=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-behavior.XXXXXX")
cleanup() { rm -rf "$T"; }
trap cleanup EXIT HUP INT TERM

TESTS_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SCRIPTS_DIR=$(CDPATH= cd -- "$TESTS_DIR/.." && pwd)
BOOTSTRAP="$SCRIPTS_DIR/bootstrap-repository"
[ -x "$BOOTSTRAP" ] || {
  printf '%s\n' "bootstrap-behavior: missing $BOOTSTRAP" >&2
  exit 1
}

MANAGED_PATHS=$(awk -F"'" '/^MANAGED_PATHS=/ {print $2}' "$BOOTSTRAP")
[ -n "$MANAGED_PATHS" ] || {
  printf '%s\n' "bootstrap-behavior: cannot read MANAGED_PATHS from $BOOTSTRAP" >&2
  exit 1
}

# ---------------------------------------------------------------- harness

n=0
failed=0
okc() {
  n=$((n + 1))
  printf 'ok %d - %s\n' "$n" "$1"
}
badc() {
  n=$((n + 1))
  failed=$((failed + 1))
  printf 'not ok %d - %s\n' "$n" "$1"
  if [ $# -gt 1 ]; then
    printf '%s\n' "$2" | sed 's/^/    /' >&2
  fi
}
expect_ok() {
  d=$1
  shift
  if "$@" >"$T/case.out" 2>"$T/case.err"; then
    okc "$d"
  else
    badc "$d" "command failed: $(cat "$T/case.err" "$T/case.out")"
  fi
}
expect_fail() {
  d=$1
  shift
  if "$@" >"$T/case.out" 2>"$T/case.err"; then
    badc "$d" "unexpectedly succeeded: $(cat "$T/case.out")"
  else
    okc "$d"
  fi
}
assert_out() { # <desc> <needle in last command output>
  if grep -qF -e "$2" "$T/case.err" "$T/case.out" 2>/dev/null; then
    okc "$1"
  else
    badc "$1" "expected output containing: $2"
  fi
}
assert_eq() { # <desc> <got> <want>
  if [ "$2" = "$3" ]; then
    okc "$1"
  else
    badc "$1" "expected '$3', got '$2'"
  fi
}
assert_file_eq() { # <desc> <file1> <file2>
  if cmp -s "$2" "$3"; then
    okc "$1"
  else
    badc "$1" "files differ: $2 vs $3"
  fi
}
assert_file_contains() { # <desc> <file> <literal needle>
  if grep -qF -e "$3" "$2" 2>/dev/null; then
    okc "$1"
  else
    badc "$1" "expected $2 to contain: $3"
  fi
}
assert_empty() { # <desc> <file>
  if [ ! -s "$2" ]; then
    okc "$1"
  else
    badc "$1" "expected empty file: $2 ($(head -c 200 "$2"))"
  fi
}

# ---------------------------------------------------------------- mock gh

mockbin=$T/bin
mkdir -p "$mockbin"
cat >"$mockbin/gh" <<'MOCK'
#!/usr/bin/env sh
M=${MOCK_STATE:?MOCK_STATE not set}
die() {
  printf 'mock-gh: %s\n' "$*" >&2
  exit 9
}
case ${1:-} in
  repo)
    [ "${2:-}" = view ] || die "unsupported: repo ${2:-}"
    jq -r '.nameWithOwner // ""' "$M/repo.json"
    exit 0
    ;;
  api) ;;
  *) die "unsupported subcommand: ${1:-}" ;;
esac
[ $# -gt 0 ] || die "missing arguments"
shift
method=GET
header=0
url=
while [ $# -gt 0 ]; do
  case $1 in
    -X)
      method=${2:-GET}
      shift
      ;;
    -i)
      header=1
      ;;
    -H)
      shift
      ;;
    --input) shift ;;
    -q | --jq) shift ;;
    *)
      [ -n "$url" ] || url=$1
      ;;
  esac
  shift
done
[ -n "$url" ] || die "no url"
case $url in
  */rulesets | */rulesets\?*)
    if [ "$method" != GET ]; then
      write_status=$(cat "$M/ruleset-write.status" 2>/dev/null || printf 200)
      if [ "$write_status" != 200 ]; then
        cat >/dev/null || true
        printf 'HTTP/2 %s\n' "$write_status" >&2
        exit 1
      fi
      body=$(cat)
      {
        printf '%s %s body: ' "$method" "$url"
        printf '%s\n' "$body"
      } >>"$M/mutations.log"
      slug=$(printf '%s' "$url" | sed -E 's#.*repos/([^/]+/[^/]+)/rulesets.*#\1#')
      stored=$(printf '%s' "$body" | jq --arg src "$slug" '{name: .name, target: .target, enforcement: .enforcement, conditions: .conditions, bypass_actors: (.bypass_actors // []), rules: .rules, id: 424242, source_type: "Repository", source: $src}')
      printf '%s\n' "$stored" >"$M/ruleset-424242.json"
      jq --argjson o "$stored" '. + [$o]' "$M/rulesets-repo.json" >"$M/tmp.json" &&
        mv "$M/tmp.json" "$M/rulesets-repo.json"
      jq --argjson o "$stored" '. + [$o]' "$M/rulesets-all.json" >"$M/tmp.json" &&
        mv "$M/tmp.json" "$M/rulesets-all.json"
      printf '%s\n' '{"id":424242,"name":"Protect main","target":"branch","source_type":"Repository","enforcement":"active"}'
      exit 0
    fi
    case $url in
      *includes_parents=false*) cat "$M/rulesets-repo.json" ;;
      *includes_parents=true*) cat "$M/rulesets-all.json" ;;
      *) die "ambiguous ruleset list url: $url" ;;
    esac
    ;;
  */rulesets/*)
    id=${url##*/}
    if [ "$method" = PUT ]; then
      write_status=$(cat "$M/ruleset-write.status" 2>/dev/null || printf 200)
      if [ "$write_status" != 200 ]; then
        cat >/dev/null || true
        printf 'HTTP/2 %s\n' "$write_status" >&2
        exit 1
      fi
      body=$(cat)
      {
        printf '%s %s body: ' "$method" "$url"
        printf '%s\n' "$body"
      } >>"$M/mutations.log"
      stored=$(printf '%s' "$body" | jq --arg id "$id" '{name: .name, target: .target, enforcement: .enforcement, conditions: .conditions, bypass_actors: (.bypass_actors // []), rules: .rules, id: ($id | tonumber), source_type: "Repository", source: (.source // $source)}' --arg source "$(jq -r '.source // ""' "$M/ruleset-$id.json" 2>/dev/null)" 2>/dev/null || printf '%s' "$body")
      printf '%s\n' "$stored" >"$M/ruleset-$id.json"
      printf '%s\n' "$stored"
    else
      [ -f "$M/ruleset-$id.json" ] || die "no fixture ruleset-$id.json"
      cat "$M/ruleset-$id.json"
    fi
    ;;
  orgs/*/teams/*/repos/*)
    st=$(cat "$M/teamrepo.status" 2>/dev/null || printf 404)
    printf 'HTTP/2 %s\n\n' "$st"
    [ "$st" = 200 ] && [ -f "$M/teamrepos.json" ] && cat "$M/teamrepos.json"
    exit 0
    ;;
  orgs/*/teams/*)
    st=$(cat "$M/team.status" 2>/dev/null || printf 404)
    printf 'HTTP/2 %s\n' "$st"
    [ "$st" = 200 ] && printf '%s\n' '{"id":77,"name":"platform","slug":"platform"}'
    exit 0
    ;;
  users/*)
    login=${url##*/}
    if [ -f "$M/user-$login.json" ]; then
      [ "$header" = 1 ] && printf 'HTTP/2 200\n'
      cat "$M/user-$login.json"
    else
      if [ "$header" = 1 ]; then
        printf 'HTTP/2 404\n'
      else
        exit 1
      fi
    fi
    ;;
  */collaborators/*/permission)
    seg=${url#*/collaborators/}
    login=${seg%%/*}
    [ -f "$M/perm-$login.json" ] || die "no fixture perm-$login.json"
    cat "$M/perm-$login.json"
    ;;
  repos/*)
    # Bare repository metadata endpoint.
    cat "$M/repo.json"
    ;;
  *)
    die "unsupported url: $url"
    ;;
esac
exit 0
MOCK
chmod +x "$mockbin/gh"

# --------------------------------------------------------- fixture helpers

REPO_SLUG=owner/repo-under-test

scenario() { # <name> <owner-login> <owner-type>
  S=$T/$1
  mkdir -p "$S/mock" "$S/repo/.github"
  : >"$S/mock/mutations.log"
  (cd "$S/repo" && git init -q .)
  jq -n --arg r "$REPO_SLUG" --arg o "$2" --arg t "$3" \
    '{nameWithOwner: $r, full_name: $r, owner: {login: $o, type: $t}}' \
    >"$S/mock/repo.json"
}
exact_ruleset() { # <id>
  jq -n --arg id "$1" --arg repo "$REPO_SLUG" '
  {
    id: ($id | tonumber),
    name: "Protect main",
    target: "branch",
    source_type: "Repository",
    source: $repo,
    enforcement: "active",
    conditions: {ref_name: {include: ["refs/heads/main"], exclude: []}},
    rules: [
      {type: "deletion"},
      {type: "non_fast_forward"},
      {type: "pull_request", parameters: {
        required_approving_review_count: 0,
        dismiss_stale_reviews_on_push: false,
        required_reviewers: [],
        require_code_owner_review: false,
        require_last_push_approval: false,
        required_review_thread_resolution: true,
        require_extra_approval_for_unattributed_changes: false,
        allowed_merge_methods: ["merge", "squash", "rebase"]}},
      {type: "required_status_checks", parameters: {
        strict_required_status_checks_policy: false,
        do_not_enforce_on_create: false,
        required_status_checks: [{context: "verify"}]}}
    ]
  }'
}
set_repo_rulesets() { # <json-array-for-repo> <json-array-for-all>
  printf '%s\n' "$1" >"$S/mock/rulesets-repo.json"
  printf '%s\n' "$2" >"$S/mock/rulesets-all.json"
}
set_user() { # <login> <type>
  jq -n --arg t "$2" '{type: $t}' >"$S/mock/user-$1.json"
}
set_perm() { # <login> <permission>
  jq -n --arg p "$2" '{permission: $p}' >"$S/mock/perm-$1.json"
}
set_teamrepo_perm() { # <level: pull|triage|push|maintain|admin> [role_name override] — one
  # repo object, as the media-type direct permission check returns it
  # (cumulative booleans + role_name; custom repository roles carry an
  # arbitrary role_name beside the standard permission booleans).
  rp_lvl=$1
  rp_role=${2:-}
  [ -n "$rp_role" ] || {
    if [ "$rp_lvl" = push ]; then rp_role=write; else rp_role=$rp_lvl; fi
  }
  jq -n --arg full "$REPO_SLUG" --arg lvl "$rp_lvl" --arg role "$rp_role" '
    {full_name: $full, role_name: $role,
      permissions: {
        pull: ($lvl == "pull" or $lvl == "triage" or $lvl == "push" or $lvl == "maintain" or $lvl == "admin"),
        triage: ($lvl == "triage" or $lvl == "push" or $lvl == "maintain" or $lvl == "admin"),
        push: ($lvl == "push" or $lvl == "maintain" or $lvl == "admin"),
        maintain: ($lvl == "maintain" or $lvl == "admin"),
        admin: ($lvl == "admin")}}' >"$S/mock/teamrepos.json"
}
default_fixtures() {
  set_user alice User
  set_perm alice admin
  set_user bob User
  set_perm bob write
  set_user carol User
  set_user anthracite-labs User
  set_perm anthracite-labs admin
}
write_co() { # <owner field, e.g. '@alice' or '@a @b'>
  {
    printf '%s\n' '# Ownership of sensitive operating surfaces.'
    printf '%s\n' '#'
    printf '%s\n' '# fixture header commentary'
    for p in $MANAGED_PATHS; do
      printf '%s %s\n' "$p" "$1"
    done
    printf '%s\n' '/custom/ @custom-owner'
    printf '%s\n' '*.go docs@example.com'
    printf '%s\n' '*.js @js-owner # inline CODEOWNERS comment'
    printf '%s\n' '/multi/ @owner-one @owner-two'
  } >"$S/repo/.github/CODEOWNERS"
}
run() { # bootstrap args...
  (cd "$S/repo" && MOCK_STATE=$S/mock PATH="$mockbin:$PATH" "$BOOTSTRAP" "$@")
}

co_owner() { # <file> <path> -> owner token incl. '@'
  awk -v p="$1" '$1 == p {print $2}' "$2" 2>/dev/null || true
}
co_owner_at() { # <file> <path>
  awk -v p="$2" '$1 == p {print $2}' "$1"
}

# ============================================================== scenarios

# 1 + 6 + 9 + 14a: user-owned default; custom rules preserved; no
# ruleset write is attempted when the ruleset already matches; rerun is a no-op.
scenario s1 alice User
default_fixtures
write_co '@anthracite-labs'
set_repo_rulesets "$(jq -n --argjson r "$(exact_ruleset 111)" '[$r]')" \
  "$(jq -n --argjson r "$(exact_ruleset 111)" '[$r]')"
exact_ruleset 111 >"$S/mock/ruleset-111.json"
cp "$S/repo/.github/CODEOWNERS" "$S/co.before"
expect_ok 's1: apply (user-owned default, ruleset matches, no admin)' run
assert_eq 's1: managed owner substituted with repository owner user' \
  "$(co_owner_at "$S/repo/.github/CODEOWNERS" '/AGENTS.md')" '@alice'
assert_eq 's1: every managed rule moved' \
  "$(for p in $MANAGED_PATHS; do co_owner "$p" "$S/repo/.github/CODEOWNERS"; done | sort -u)" \
  '@alice'
assert_file_contains 's1: custom @owner rule preserved' "$S/repo/.github/CODEOWNERS" '/custom/ @custom-owner'
assert_file_contains 's1: custom email owner preserved' "$S/repo/.github/CODEOWNERS" '*.go docs@example.com'
assert_file_contains 's1: custom inline comment preserved' "$S/repo/.github/CODEOWNERS" '*.js @js-owner # inline CODEOWNERS comment'
assert_file_contains 's1: custom multi-owner rule preserved' "$S/repo/.github/CODEOWNERS" '/multi/ @owner-one @owner-two'
assert_file_contains 's1: header comment preserved' "$S/repo/.github/CODEOWNERS" 'fixture header commentary'
assert_empty 's1: no GitHub mutation performed' "$S/mock/mutations.log"
cp "$S/repo/.github/CODEOWNERS" "$S/co.after-first"
expect_ok 's1: second apply is a no-op' run
assert_file_eq 's1: rerun changed nothing' "$S/repo/.github/CODEOWNERS" "$S/co.after-first"
expect_ok 's1: --check passes without administration' run --check
assert_out 's1: check reports satisfaction' 'all repository-specific requirements are satisfied'

# 2: organization-owned repository without override refuses safely.
scenario s2 acme Organization
write_co '@anthracite-labs'
set_repo_rulesets '[]' '[]'
cp "$S/repo/.github/CODEOWNERS" "$S/co.before"
expect_fail 's2: org-owned apply without --owner refuses' run
assert_out 's2: explains the explicit-owner requirement' 'Provide a deliberate explicit owner: --owner USER'
assert_out 's2: names ORG/TEAM option' '--owner ORG/TEAM'
assert_file_eq 's2: CODEOWNERS untouched' "$S/repo/.github/CODEOWNERS" "$S/co.before"
assert_empty 's2: nothing mutated on GitHub' "$S/mock/mutations.log"

# 3: organization team override end to end (full token, check, no-op rerun).
scenario s3 acme Organization
printf '200\n' >"$S/mock/team.status"
printf '200\n' >"$S/mock/teamrepo.status"
set_teamrepo_perm push
write_co '@anthracite-labs'
set_repo_rulesets "$(printf '[%s]' "$(exact_ruleset 111)")" "$(printf '[%s]' "$(exact_ruleset 111)")"
exact_ruleset 111 >"$S/mock/ruleset-111.json"
expect_ok 's3: apply with ORG/TEAM override' run --owner acme/platform
assert_eq 's3: full team token preserved in managed rules' \
  "$(co_owner_at "$S/repo/.github/CODEOWNERS" '/docs/')" '@acme/platform'
expect_ok 's3: --check recognizes the managed team without arguments' run --check
assert_out 's3: check validates the explicit owner' 'validated explicit owner (@acme/platform)'
expect_ok 's3: --check accepts the same explicit assertion' run --check --owner acme/platform
cp "$S/repo/.github/CODEOWNERS" "$S/co.after-first"
expect_ok 's3: rerun apply is a no-op' run --owner acme/platform
assert_file_eq 's3: rerun changed nothing' "$S/repo/.github/CODEOWNERS" "$S/co.after-first"

# 3t: team eligibility — a code owner team must have write permission or
# higher; read/pull and triage, no access, and unverifiable level are refused.
for lvl in pull triage; do
  scenario "s3t-$lvl" acme Organization
  printf '200\n' >"$S/mock/team.status"
  printf '200\n' >"$S/mock/teamrepo.status"
  set_teamrepo_perm "$lvl"
  write_co '@anthracite-labs'
  expect_fail "s3t: '$lvl'-permission team is refused" run --owner acme/platform
  assert_out "s3t: '$lvl' refusal states the write-or-higher requirement" \
    'must have effective write permission or higher'
done

for lvl in maintain admin; do
