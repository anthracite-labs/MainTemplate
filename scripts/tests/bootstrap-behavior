# 8: a denied ruleset write leaves CODEOWNERS unchanged. This covers the
# important read-vs-write permission gap: a read-only endpoint cannot prove
# ruleset-write authority, so the real write is attempted before local install.
scenario s8a alice User
set_user alice User
set_perm alice admin
write_co '@anthracite-labs'
set_repo_rulesets '[]' '[]'
printf '403\n' >"$S/mock/ruleset-write.status"
cp "$S/repo/.github/CODEOWNERS" "$S/co.before"
expect_fail 's8a: denied ruleset creation fails before CODEOWNERS install' run
assert_out 's8a: reports unsuccessful ruleset creation' 'ruleset creation did not report success'
assert_out 's8a: explains CODEOWNERS was not changed' '.github/CODEOWNERS was not changed'
assert_file_eq 's8a: working tree CODEOWNERS unchanged' "$S/repo/.github/CODEOWNERS" "$S/co.before"
assert_empty 's8a: denied create produced no recorded GitHub mutation' "$S/mock/mutations.log"

