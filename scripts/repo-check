#!/usr/bin/env sh
set -eu

fail() {
  printf '%s\n' "repo-check: $*" >&2
  exit 1
}

require_file() {
  [ -f "$1" ] || fail "required file missing: $1"
}

required_files='
AGENTS.md
README.md
.gitattributes
.agents/RESEARCH.md
.agents/chatgpt/AGENTS.md
.agents/chatgpt/ARENA-DISPATCH.md
.agents/arena/AGENTS.md
.agents/workflows/research.md
.agents/workflows/plan.md
.agents/workflows/implement.md
.agents/workflows/debug.md
.agents/workflows/hitl-loop.template.sh
.agents/workflows/review.md
.agents/workflows/security.md
.agents/workflows/recover.md
.agents/skills/README.md
.agents/skills/PROVENANCE.md
.agents/skills/writing-for-agents/SKILL.md
.agents/skills/writing-for-agents/MECHANICS.md
.agents/skills/grilling/SKILL.md
.agents/skills/domain-modeling/SKILL.md
.agents/skills/domain-modeling/CONTEXT-FORMAT.md
.agents/skills/domain-modeling/ADR-FORMAT.md
.agents/skills/codebase-design/SKILL.md
.agents/skills/codebase-design/DEEPENING.md
.agents/skills/codebase-design/DESIGN-IT-TWICE.md
.agents/skills/tdd/SKILL.md
.agents/skills/tdd/tests.md
.agents/skills/tdd/mocking.md
.agents/skills/to-spec/SKILL.md
.agents/skills/to-tickets/SKILL.md
.agents/skills/wayfinder/SKILL.md
.agents/skills/prototype/SKILL.md
.agents/skills/prototype/LOGIC.md
.agents/skills/prototype/UI.md
.agents/skills/improve-codebase-architecture/SKILL.md
.agents/skills/improve-codebase-architecture/REPORT-FORMAT.md
.agents/skills/resolving-merge-conflicts/SKILL.md
.agents/skills/security-audit/LICENSE
.agents/skills/security-audit/SKILL.md
.agents/skills/security-audit/RECONNAISSANCE.md
.agents/skills/security-audit/HUNTING.md
.agents/skills/security-audit/ATTACK-CLASSES.md
.agents/skills/security-audit/AI-AND-LLM.md
.agents/skills/security-audit/CLIENT-SIDE.md
.agents/skills/security-audit/CLOUD-AND-DEPLOYMENT.md
.agents/skills/security-audit/DATA-ISOLATION-AND-LIFECYCLE.md
.agents/skills/security-audit/DESKTOP-MOBILE-AND-LOCAL-IPC.md
.agents/skills/security-audit/MEMORY-SAFETY-AND-BINARY.md
.agents/skills/security-audit/PROTOCOLS-RPC-AND-MESSAGING.md
.agents/skills/security-audit/RESOURCE-EXHAUSTION-AND-AVAILABILITY.md
.agents/skills/security-audit/SUPPLY-CHAIN-AND-RELEASE.md
.agents/skills/security-audit/VALIDATION-AND-REPORTING.md
.agents/skills/security-audit/WEB-PROTOCOL-AND-AUTH.md
.agents/skills/security-audit/report-schema.json
.agents/skills/security-audit/validate-findings.cjs
.agents/skills/security-audit/validate-findings.test.cjs
.agents/skills/security-audit/validate-coverage-ledger.cjs
.agents/skills/security-audit/validate-coverage-ledger.test.cjs
.github/ISSUE_TEMPLATE/arena-task.md
.github/PULL_REQUEST_TEMPLATE.md
.github/CODEOWNERS
.github/workflows/verify.yml
scripts/verify
scripts/repo-check
docs/README.md
docs/architecture/agent-operating-stack.md
'

printf '%s\n' "$required_files" | while IFS= read -r path; do
  [ -z "$path" ] && continue
  require_file "$path"
done

# The governed capability surface is an exact present-tense list, not a future
# directory reservation. Adding a capability means updating this invariant and
# the catalog/provenance in the same change.
required_skill_dirs='
codebase-design
domain-modeling
grilling
improve-codebase-architecture
prototype
resolving-merge-conflicts
security-audit
tdd
to-spec
to-tickets
wayfinder
writing-for-agents
'

actual_skill_dirs=$(
  find .agents/skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort
)
expected_skill_dirs=$(printf '%s\n' "$required_skill_dirs" | sed '/^$/d' | LC_ALL=C sort)
[ "$actual_skill_dirs" = "$expected_skill_dirs" ] ||
  fail "skill directory surface differs from the governed current list"

printf '%s\n' "$required_skill_dirs" | while IFS= read -r skill; do
  [ -z "$skill" ] && continue
  [ -f ".agents/skills/$skill/SKILL.md" ] ||
    fail "capability has no SKILL.md: .agents/skills/$skill"
  [ "$(find ".agents/skills/$skill" -type f | wc -l | tr -d ' ')" -gt 0 ] ||
    fail "capability is empty: .agents/skills/$skill"
done

[ ! -e state.json ] || fail "root state.json is not part of the canonical state model"
[ ! -e CURRENT.md ] || fail "root CURRENT.md is not part of the canonical state model"

lines=$(wc -l < AGENTS.md | tr -d ' ')
[ "$lines" -le 200 ] || fail "AGENTS.md exceeds 200-line routing budget ($lines)"

[ -x scripts/verify ] || fail "scripts/verify must be executable"
[ -x scripts/repo-check ] || fail "scripts/repo-check must be executable"
[ -x scripts/bootstrap-repository ] || fail "scripts/bootstrap-repository must be executable"
[ -x scripts/tests/bootstrap-behavior ] || fail "scripts/tests/bootstrap-behavior must be executable"
[ -x .agents/workflows/hitl-loop.template.sh ] ||
  fail "hitl-loop.template.sh must be executable"

sh -n scripts/verify
sh -n scripts/repo-check
sh -n scripts/bootstrap-repository
sh -n scripts/tests/bootstrap-behavior
bash -n .agents/workflows/hitl-loop.template.sh

# Architecture is not version-branded: the current architecture has no version
# label, and none may quietly return. Vendored upstream content is excluded.
for doc in AGENTS.md README.md docs/README.md docs/architecture/agent-operating-stack.md; do
  if grep -nE '\bV[0-9]+\b' "$doc" > "${TMPDIR:-/tmp}/repo-check-version.$$" 2>/dev/null; then
    cat "${TMPDIR:-/tmp}/repo-check-version.$$" >&2
    rm -f "${TMPDIR:-/tmp}/repo-check-version.$$"
    fail "architecture version marker reintroduced in $doc (the architecture is not versioned)"
  fi
  rm -f "${TMPDIR:-/tmp}/repo-check-version.$$"
done

# .github/CODEOWNERS managed-rule invariants. These are repository-local and
# mechanical only; GitHub validity/access verification belongs to
# scripts/bootstrap-repository --check. The managed-path list and the
# source-template owner are read from the bootstrap script (single owner).
command -v jq >/dev/null 2>&1 || fail "jq is required by scripts/bootstrap-repository"
managed_paths=$(awk -F"'" '/^MANAGED_PATHS=/ {print $2}' scripts/bootstrap-repository)
template_owner=$(awk -F= '/^TEMPLATE_OWNER=/ {print $2}' scripts/bootstrap-repository)
[ -n "$managed_paths" ] || fail "cannot read MANAGED_PATHS from scripts/bootstrap-repository"
[ -n "$template_owner" ] || fail "cannot read TEMPLATE_OWNER from scripts/bootstrap-repository"

valid_owner_token() {
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?$'
}

co_managed_token=
for p in $managed_paths; do
  rows=$(awk -v want="$p" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $1 == want { printf "%d:", NR; for (i = 2; i <= NF; i++) printf "%s ", $i; printf "\n" }
  ' .github/CODEOWNERS)
  rows_n=$(printf '%s\n' "$rows" | sed '/^$/d' | wc -l | tr -d ' ')
  [ "$rows_n" -eq 1 ] ||
    fail ".github/CODEOWNERS managed rule for '$p' appears $rows_n times (expected exactly one)"
  line=$(printf '%s\n' "$rows" | head -n 1)
  owners=${line#*:}
  tokens=
  for t in $owners; do
    case $t in
      @*) tok=${t#@} ;;
      *) fail ".github/CODEOWNERS managed rule for '$p' has a non-'@' owner token '$t'" ;;
    esac
    valid_owner_token "$tok" ||
      fail ".github/CODEOWNERS managed rule for '$p' has an invalid owner token '@$tok'"
    tokens="$tokens $tok"
  done
  set -- $tokens
  [ $# -eq 1 ] ||
    fail ".github/CODEOWNERS managed rule for '$p' has $# owner tokens; the template manages exactly one owner per managed rule"
  if [ -z "$co_managed_token" ]; then
    co_managed_token=$1
  elif [ "$co_managed_token" != "$1" ]; then
    fail ".github/CODEOWNERS managed rules disagree on the owner (@$co_managed_token vs @$1); the managed rules must state one managed owner"
  fi
done
[ -n "$co_managed_token" ] || fail ".github/CODEOWNERS contains no managed owner rules"

# Only the six bootstrap-managed rules are constrained here. Custom CODEOWNERS
# rules are deliberately left to GitHub's CODEOWNERS parser: valid custom rules
# may use multiple owners, email owners, inline comments, and other supported
# syntax. repo-check must not become a competing partial CODEOWNERS parser.

# Stale source-template owner: a repository created from this template keeps
# the template owner in the managed rules until scripts/bootstrap-repository
# substitutes a validated owner; deterministic verification fails by design
# until then. Deliberate non-default owners and the template repository itself
# pass. Skipped when the origin remote is absent or not GitHub.
if remote_url=$(git remote get-url origin 2>/dev/null); then
  case $remote_url in
    *github.com[:/]*)
      origin_owner=$(printf '%s\n' "$remote_url" | sed -E 's#^.*[/:]([^/]+)/[^/]+(\.git)?$#\1#')
      if [ "$origin_owner" != "$template_owner" ]; then
        case $co_managed_token in
          "$template_owner" | "$template_owner"/*)
            fail "source-template owner residue: managed CODEOWNERS rules still name @$co_managed_token while this repository is owned by @$origin_owner; run scripts/bootstrap-repository"
            ;;
        esac
      fi
      ;;
  esac
fi

printf '%s\n' "repo-check: ok"
