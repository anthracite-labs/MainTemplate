#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

./scripts/repo-check

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  empty_tree=$(git hash-object -t tree /dev/null)
  git diff --check "$empty_tree" HEAD
fi

printf '%s\n' "verify: ok"
