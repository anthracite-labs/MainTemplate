#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

./scripts/repo-check

# Bootstrap behavior tests: deterministic, offline — the real bootstrap runs
# against fixture repositories behind a mocked gh boundary, so ordering,
# idempotence, and refusal behavior are verified without touching GitHub.
./scripts/tests/bootstrap-behavior

# Vendored Cloudflare validators and their tests. Run wherever Node is
# available; a no-Node environment still verifies repository structure.
if command -v node >/dev/null 2>&1; then
  node --test \
    .agents/vendor/cloudflare/skills/security-audit/validate-findings.test.cjs \
    .agents/vendor/cloudflare/skills/security-audit/validate-coverage-ledger.test.cjs
else
  printf '%s\n' "verify: Node unavailable; skipped security-audit validator tests" >&2
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
   git rev-parse --verify -q HEAD >/dev/null; then
  empty_tree=$(git hash-object -t tree /dev/null)

  git diff --check "$empty_tree" HEAD

  scratch_index=$(mktemp "${TMPDIR:-/tmp}/verify-index.XXXXXX")
  trap 'rm -f "$scratch_index"' EXIT HUP INT TERM
  rm -f "$scratch_index"

  GIT_INDEX_FILE="$scratch_index" git read-tree HEAD
  GIT_INDEX_FILE="$scratch_index" git add -A
  GIT_INDEX_FILE="$scratch_index" git diff --cached --check HEAD
fi

printf '%s\n' "verify: ok"
